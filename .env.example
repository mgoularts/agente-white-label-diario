# Copie para .env e preencha. NUNCA suba o .env para o GitHub.
# Passo a passo de cada valor: guiadeconexoes.md

# ── Identidade (é aqui que o agente vira "seu") ─────────────────────────────
# Nome da assistente, como ela se apresenta no Telegram.
NOME_ASSISTENTE=Aurora
# Seu nome (ou o do cliente que vai usar o agente).
NOME_USUARIO=Fulano
# Uma frase sobre a rotina de quem ela atende. Quanto mais específica, mais
# personalizadas ficam as respostas, o bom-dia e as sugestões.
PERFIL_USUARIO=trabalha como consultor autônomo, atende vários clientes e precisa de ajuda para organizar agenda, tarefas e finanças

# ── Obrigatórias ────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=cole_aqui_o_token_do_BotFather
GEMINI_API_KEY=cole_aqui_a_chave_do_Google_AI_Studio
# ID da agenda do Google que a assistente vai ler e editar (na agenda principal,
# é o próprio e-mail da conta Google). Compartilhe essa agenda com o e-mail da
# service account — veja o guia.
EMAIL_AGENDA=seu-email@gmail.com

# Só este chat conversa com a assistente. MUITO IMPORTANTE: preencha.
# Vazio, o primeiro chat que falar com o bot vira o dono — inclusive um estranho.
# Como descobrir o seu: guiadeconexoes.md, passo 5.
OWNER_CHAT_ID=

# ── Opcionais (têm padrão) ──────────────────────────────────────────────────
HORARIO_MANHA=07:00
HORARIO_NOITE=22:00
ANTECEDENCIA_LEMBRETE=30

# Fila de modelos: se a cota grátis de um acabar, cai para o próximo.
# Os nomes de modelo do Gemini mudam com o tempo; confira os atuais em
# https://ai.google.dev/gemini-api/docs/models e ajuste a lista se precisar.
MODELOS_GEMINI=gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-latest,gemini-flash-lite-latest

# ── Só para deploy na nuvem ─────────────────────────────────────────────────
# Pasta persistente (volume) onde o data.json deve viver. Sem isso, os dados
# somem a cada novo deploy em hosts de disco efêmero.
# DATA_DIR=/data

# Conteúdo do credentials.json em UMA linha, para hosts que não aceitam upload
# de arquivo. Se preenchido, substitui o credentials.json.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account", ...}
